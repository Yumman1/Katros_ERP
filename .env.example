# ─── Kastros CTRM environment ─────────────────────────────────────────────────
# Copy to .env and fill in real values. Example Supabase project ref:
#   qyvdpbkxqgqyzuwpynpd (region ap-south-1)

# Pooled connection (pgBouncer, port 6543) — used by the app / Prisma Client.
# On Vercel the Supabase integration sets this automatically; locally copy the
# "ORMs" tab of the Supabase Connect dialog. Keep pgbouncer=true.
POSTGRES_PRISMA_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by prisma migrate / db push only.
# Set automatically by the Supabase integration on Vercel.
POSTGRES_URL_NON_POOLING="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth JWT signing secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Canonical app URL (http://localhost:3000 in dev, deployment URL in prod).
NEXTAUTH_URL="http://localhost:3000"

# Supabase project URL (Storage API for gatepass document uploads).
SUPABASE_URL="https://qyvdpbkxqgqyzuwpynpd.supabase.co"

# Service-role key (server-side only, NEVER expose to the browser) — used for
# Storage uploads that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Storage bucket for gatepass documents (builty, weigh slips, photos).
SUPABASE_STORAGE_BUCKET="gatepass-docs"

# Dev-only: when "true", logins for emails not found in the DB fall back to
# mock demo identities (passwords "demo" / "Kastros123!"). Leave unset in prod.
MOCK_MODE="false"
