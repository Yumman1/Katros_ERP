// Kastros CTRM — Supabase PostgreSQL schema (Prisma 5)
//
// This schema is the single source of truth for the cloud deployment:
// - Frontend + tRPC API on Vercel (serverless) → POSTGRES_PRISMA_URL must be the
//   Supabase *pooled* connection string (pgBouncer, port 6543);
//   POSTGRES_URL_NON_POOLING is the direct connection used for migrations.
// - The former mock JSON runtime (booked trades, execution state, master
//   data, change requests, market prices, position adjustments) is modeled
//   relationally below with real foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Variable names match what the Supabase↔Vercel integration injects
  // automatically: POSTGRES_PRISMA_URL is the pooled (pgBouncer) connection,
  // POSTGRES_URL_NON_POOLING the direct connection used for migrations.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Auth & RBAC ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CEO
  TRADER
  EXECUTION
  RISK_MANAGER
  FINANCE
  READ_ONLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(READ_ONLY)
  /// Department head flag — drives headProcedure authorization (approvals).
  isHead       Boolean  @default(false)
  /// Disabled accounts cannot log in (managed on the CEO → Users page).
  disabled     Boolean  @default(false)
  /// Presence heartbeat — updated (throttled) on every authenticated API call.
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commoditiesCreated         Commodity[]          @relation("CommodityCreatedBy")
  counterpartiesCreated      Counterparty[]       @relation("CounterpartyCreatedBy")
  locationsCreated           Location[]           @relation("LocationCreatedBy")
  tradesCreated              Trade[]              @relation("TradeCreatedBy")
  marketPricesCreated        MarketPrice[]        @relation("MarketPriceCreatedBy")
  positionsCreated           Position[]           @relation("PositionCreatedBy")
  positionLegsCreated        PositionLeg[]        @relation("PositionLegCreatedBy")
  mtmValuesCreated           MTMValue[]           @relation("MTMValueCreatedBy")
  inventoriesCreated         Inventory[]          @relation("InventoryCreatedBy")
  inventoryMovementsCreated  InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  invoicesCreated            Invoice[]            @relation("InvoiceCreatedBy")
  paymentsCreated            Payment[]            @relation("PaymentCreatedBy")
  cashFlowEntriesCreated     CashFlowEntry[]      @relation("CashFlowEntryCreatedBy")
  reconciliationsCreated     Reconciliation[]     @relation("ReconciliationCreatedBy")
  traceabilityRecordsCreated TraceabilityRecord[] @relation("TraceabilityRecordCreatedBy")
  traceChainEntriesCreated   TraceChainEntry[]    @relation("TraceChainEntryCreatedBy")
  bankTransactionsCreated    BankTransaction[]    @relation("BankTransactionCreatedBy")
  traceLinksCreated          TradeTraceabilityLink[] @relation("TradeTraceLinkCreatedBy")
  shipmentsCreated           Shipment[]           @relation("ShipmentCreatedBy")
  changeRequestsRequested    ChangeRequest[]      @relation("ChangeRequestRequestedBy")
}

// ─── Reference / Master data ─────────────────────────────────────────────────

enum CommodityCategory {
  GRAINS
  OILSEEDS
  SOFTS
  VEGOIL
  OTHER
}

model Commodity {
  id         String            @id @default(cuid())
  name       String
  code       String            @unique
  /// Canonical quantity unit used throughout the app (default MT).
  unit       String
  exchange   String?
  tickerCode String?
  category   CommodityCategory
  /// Kilograms per one canonical quantity unit (e.g. MT → 1000).
  canonicalKgPerUnit Decimal?  @db.Decimal(12, 4)
  /// How this commodity is priced per market (currency/weight-unit config).
  priceUnits         Json?
  /// Commodity-specific booking form fields (TradeParamDefinition[]).
  tradeParameterDefs Json?
  /// Allowed grades for this commodity (merged seeded + custom).
  grades             String[]  @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String
  createdBy   User             @relation("CommodityCreatedBy", fields: [createdById], references: [id])

  trades              Trade[]
  positions           Position[]
  inventories         Inventory[]
  prices              MarketPrice[]
  traceabilityRecords TraceabilityRecord[]
  deskPrice           DeskMarketPrice?
  positionAdjustments PositionAdjustment[]
}

/// Custom weight/quantity units with kg conversion (unit registry).
model UnitDef {
  code      String  @id
  label     String?
  kgPerUnit Decimal @db.Decimal(12, 4)
}

enum CounterpartyType {
  TRADING_PARTNER
  BUYER
  SELLER
  BROKER
  BANK
}

/// Ledger side. A counterparty is ONE record (one CP id — inventory, trades
/// and gatepasses all reference the same party) but keeps two fully separate
/// ledger accounts: BUY (payables — what we owe them on purchases) and SELL
/// (receivables — what they owe us on sales). Balances never mix.
enum CounterpartySide {
  BUY
  SELL
}

/// FBR Active Taxpayer List status — selects the 236G advance tax rate
/// (filer vs non-filer) on sales to this counterparty.
enum TaxFilerStatus {
  FILER
  NON_FILER
}

/// Approval flow when an inbound truck delivers more than a purchase trade's
/// open quantity + tolerance. It can only be accepted onto the trade once the
/// trade's trader and then the CEO approve the over-delivery.
enum InboundOverStage {
  PENDING_TRADER
  PENDING_CEO
  APPROVED
}

enum KycStatus {
  VERIFIED
  PENDING
  EXPIRED
  NOT_ON_FILE
}

model Counterparty {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  type        CounterpartyType
  /// @deprecated Registers are unified — kept for data compatibility only.
  side        CounterpartySide @default(BUY)
  /// 236G rate selector for sales to this counterparty.
  taxFilerStatus TaxFilerStatus @default(FILER)
  country     String
  creditLimit Decimal?         @db.Decimal(20, 4)
  kycStatus   KycStatus        @default(NOT_ON_FILE)
  kycRef      String?
  kycExpires  DateTime?
  /// Legal company name as registered on NTN.
  companyNameNtn String?
  ntn         String?
  /// Optional booking-form contact — saved once with the counterparty.
  contactPerson String?
  contactPhone  String?
  address     String?
  bankDetails String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String
  createdBy   User             @relation("CounterpartyCreatedBy", fields: [createdById], references: [id])

  trades   Trade[]
  invoices Invoice[]
  ledgerEntries CounterpartyLedgerEntry[]
  vouchers      Voucher[]

  @@index([side])
}

enum LocationType {
  PORT
  WAREHOUSE
  SILO
  FARM
}

model Location {
  id      String       @id @default(cuid())
  name    String       @unique
  code    String?
  type    LocationType
  country String
  /// Logistics service provider managing the warehouse.
  lsp      String?
  address  String?
  city     String?
  province String?
  // ── Warehouse capacity & costing (type WAREHOUSE) ──
  capacitySqFt        Decimal? @db.Decimal(14, 2)
  costPerSqFt         Decimal? @db.Decimal(14, 4)
  balesDivisionSqFt   Decimal? @db.Decimal(14, 2)
  grainDivisionSqFt   Decimal? @db.Decimal(14, 2)
  serviceStartDate    DateTime?
  rentalTaxPkr        Decimal? @db.Decimal(20, 2)
  managementFeePct    Decimal? @db.Decimal(6, 3)
  hiringPeriodMonths  Int?
  /// WarehouseLaborLine[] — { role, headcount, unitCostPkr }.
  laborLines          Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("LocationCreatedBy", fields: [createdById], references: [id])

  inventories       Inventory[]
  shipments         Shipment[]
  tradesOrigin      Trade[]    @relation("TradeOrigin")
  tradesDestination Trade[]    @relation("TradeDestination")
  contractAllocations ContractWarehouseAllocation[]
}

// ─── Trading ─────────────────────────────────────────────────────────────────

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  LOCKED
  CONFIRMED
  EXECUTED
  SETTLED
  CANCELLED
}

enum TradeScope {
  LOCAL
  INTERNATIONAL
}

enum BuyingCategory {
  Delivered
  Spot
}

enum ExecutionProfile {
  PURCHASE_DELIVERED
  PURCHASE_SPOT
  SALE_EX_WAREHOUSE
}

enum PaymentType {
  DP
  LC
  CAD
  ADVANCE_100
  CREDIT
  CREDIT_30
  AFTER_DELIVERY_100
}

model Trade {
  id        String         @id @default(cuid())
  tradeRef  String         @unique
  tradeDate DateTime
  desk      String         @default("Desk A")
  traderName String
  direction TradeDirection
  tradeScope TradeScope    @default(LOCAL)

  commodityId    String
  commodity      Commodity    @relation(fields: [commodityId], references: [id])
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  /// KYC snapshot taken at booking time.
  counterpartyKycStatus KycStatus @default(NOT_ON_FILE)
  counterpartyKycRef    String?

  // ── Quantity ──
  /// Canonical quantity (converted to quantityUnit, usually MT).
  quantity            Decimal @db.Decimal(20, 6)
  quantityUnit        String  @default("MT")
  /// Quantity as originally entered before canonical conversion.
  quantityEntered     Decimal? @db.Decimal(20, 6)
  quantityEnteredUnit String?

  // ── Pricing ──
  price       Decimal  @db.Decimal(20, 6)
  currency    String
  /// Fixed | Unfixed | Index-linked | Fixed/Spot
  priceBasis  String   @default("Fixed")
  priceCurrency  String?
  priceWeightUnit String?
  priceKgPerUnit  Decimal? @db.Decimal(12, 4)
  /// Price mapped to canonical qty unit in settlement (base) currency.
  pricePerCanonicalQty Decimal? @db.Decimal(20, 6)
  ratePerMaund Decimal? @db.Decimal(20, 6)
  ratePerKg    Decimal? @db.Decimal(20, 6)

  // ── Commission ──
  commissionAmount          Decimal? @db.Decimal(20, 4)
  commissionPerUnit         Decimal? @db.Decimal(20, 6)
  commissionPerMaund        Decimal? @db.Decimal(20, 6)
  commissionPerCanonicalQty Decimal? @db.Decimal(20, 6)

  // ── Delivery / logistics ──
  deliveryStart DateTime
  deliveryEnd   DateTime
  originLocationId String?
  originLocation   Location? @relation("TradeOrigin", fields: [originLocationId], references: [id])
  destLocationId   String?
  destLocation     Location? @relation("TradeDestination", fields: [destLocationId], references: [id])
  /// Free-text load / delivery points (may not match a Location row).
  originName String @default("")
  destName   String @default("")
  incoterms  String @default("Delivered")
  buyingCategory BuyingCategory?

  // ── Payment ──
  paymentType  PaymentType @default(CREDIT)
  paymentTerms String      @default("")

  // ── Quality & specs ──
  grade           String @default("")
  productOrigin   String @default("")
  /// Human-readable tolerance summary.
  qualityTolerances String @default("")
  /// { damagePct, brokenPct, fungusPct, foreignMatterPct, moisturePct }
  qualityTolerancesDetail Json?
  maxMoisturePct  Decimal? @db.Decimal(6, 3)
  /// Flexible commodity-specific + global booking fields
  /// (broker, creditDays, quantityTolerance, warehouseSelections,
  ///  executionWarehouseSplit, …).
  tradeParams Json?

  // ── Desk marks (preview MTM) ──
  marketPrice Decimal @default(0) @db.Decimal(20, 6)
  mtmPnl      Decimal @default(0) @db.Decimal(20, 4)

  notes       String?
  contractRef String?

  // ── Lifecycle ──
  tradeStatus     TradeStatus @default(PENDING)
  executionProfile ExecutionProfile?
  submittedToExecution   Boolean   @default(false)
  submittedToExecutionAt DateTime?
  /// Execution edited the trade — trader must review before lock.
  pendingTraderReview Boolean @default(false)
  /// Unfixed trade submitted without price — trader must price before lock.
  pendingTraderPrice  Boolean @default(false)
  executionEditNote     String?
  executionLastEditedBy String?
  executionLastEditedAt DateTime?
  /// Head approved warehouse qty split — required before lock for
  /// PURCHASE_DELIVERED / SALE_EX_WAREHOUSE.
  warehouseSplitApproved   Boolean   @default(false)
  warehouseSplitApprovedAt DateTime?
  warehouseSplitApprovedBy String?
  pendingWarehouseApproval Boolean   @default(false)
  lockedAt DateTime?
  lockedBy String?

  // ── Direct settlement (no delivery / gatepass) ──
  /// Trader requested to settle this trade directly — awaiting CEO approval.
  /// Only permitted while the trade is still PENDING (before lock).
  settlementRequested   Boolean   @default(false)
  /// CEO approved the direct settlement (trade closed with tradeStatus SETTLED).
  directSettled         Boolean   @default(false)
  settlementNote        String?
  settlementRequestedBy String?
  settlementRequestedAt DateTime?
  settlementApprovedBy  String?
  settlementApprovedAt  DateTime?
  /// Settlement collection finished — every rupee of the trade amount has been
  /// gathered in the counterparty's ledger, so the trade is closed for good.
  settlementClosedAt    DateTime?
  settlementClosedBy    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("TradeCreatedBy", fields: [createdById], references: [id])

  // ── Relations ──
  activityLog       TradeActivity[]
  contract          ExecutionContract?
  inboundReceipts   InboundReceipt[]
  outboundDispatches OutboundDispatch[]
  spotEvent         SpotPurchaseEvent?
  paymentRequests   PaymentRequest[]
  assignedTrucks    PendingTruck[]   @relation("TruckAssignedTrade")
  gateInvoiceTrucks PendingTruck[]   @relation("TruckGateInvoiceTrade")
  invoices          Invoice[]
  shipments         Shipment[]
  mtmValues         MTMValue[]
  positionLegs      PositionLeg[]
  traceabilityLinks TradeTraceabilityLink[]

  @@index([tradeStatus, direction])
  @@index([commodityId])
  @@index([counterpartyId])
  @@index([traderName])
}

enum ActorSide {
  TRADER
  EXECUTION
  CEO
}

/// Chronological edit/approval audit trail per trade.
model TradeActivity {
  id      String    @id @default(cuid())
  tradeId String
  trade   Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  at      DateTime  @default(now())
  actorName String
  actorSide ActorSide
  /// EDIT_APPLIED | EDIT_REQUESTED | EDIT_APPROVED | EDIT_REJECTED | DELETE_REQUESTED | …
  kind    String
  requiresApproval Boolean @default(false)
  summary String
  note    String?
  changeCount Int?
  changeRequestId String?
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  payload Json?

  @@index([tradeId, at])
}

/// Historical daily close prices (analytics).
model MarketPrice {
  id          String    @id @default(cuid())
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  priceDate   DateTime
  closePrice  Decimal   @db.Decimal(20, 6)
  currency    String
  source      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  createdBy   User      @relation("MarketPriceCreatedBy", fields: [createdById], references: [id])

  @@index([commodityId, priceDate])
}

/// Execution-desk CNF market price (one live row per commodity).
model DeskMarketPrice {
  id            String    @id @default(cuid())
  commodityCode String    @unique
  commodity     Commodity @relation(fields: [commodityCode], references: [code], onDelete: Cascade)
  cnfAmount    Decimal? @db.Decimal(20, 6)
  cnfCurrency  String?
  cnfUnit      String?
  yestAmount   Decimal? @db.Decimal(20, 6)
  yestCurrency String?
  yestUnit     String?
  priceDate    String
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

// ─── Position & MTM (analytics) ──────────────────────────────────────────────

model Position {
  id           String    @id @default(cuid())
  commodityId  String
  commodity    Commodity @relation(fields: [commodityId], references: [id])
  positionDate DateTime
  longQty      Decimal   @default(0) @db.Decimal(20, 6)
  shortQty     Decimal   @default(0) @db.Decimal(20, 6)
  netQty       Decimal   @db.Decimal(20, 6)
  avgBuyPrice  Decimal?  @db.Decimal(20, 6)
  avgSellPrice Decimal?  @db.Decimal(20, 6)
  currency     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  createdBy    User      @relation("PositionCreatedBy", fields: [createdById], references: [id])

  legs PositionLeg[]

  @@unique([commodityId, positionDate])
  @@index([positionDate])
}

model PositionLeg {
  id          String         @id @default(cuid())
  positionId  String
  position    Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  tradeId     String
  trade       Trade          @relation(fields: [tradeId], references: [id])
  quantity    Decimal        @db.Decimal(20, 6)
  direction   TradeDirection
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String
  createdBy   User           @relation("PositionLegCreatedBy", fields: [createdById], references: [id])

  @@index([tradeId])
}

model MTMValue {
  id            String   @id @default(cuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id])
  valuationDate DateTime
  marketPrice   Decimal  @db.Decimal(20, 6)
  bookPrice     Decimal  @db.Decimal(20, 6)
  mtmPnl        Decimal  @db.Decimal(20, 4)
  unrealizedPnl Decimal  @db.Decimal(20, 4)
  currency      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String
  createdBy     User     @relation("MTMValueCreatedBy", fields: [createdById], references: [id])

  @@index([tradeId, valuationDate])
}

/// Manual stock delta added by execution head (paper vs physical recon).
model PositionAdjustment {
  id            String    @id @default(cuid())
  commodityCode String
  commodity     Commodity @relation(fields: [commodityCode], references: [code], onDelete: Cascade)
  /// Empty string = commodity-level adjustment; else per-warehouse.
  warehouseName String    @default("")
  deltaMt       Decimal   @db.Decimal(20, 6)
  updatedAt     DateTime  @updatedAt

  @@unique([commodityCode, warehouseName])
}

// ─── Inventory (analytics) ───────────────────────────────────────────────────

enum InventoryStatus {
  IN_STOCK
  RESERVED
  TRANSIT
  DELIVERED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model Inventory {
  id             String          @id @default(cuid())
  commodityId    String
  commodity      Commodity       @relation(fields: [commodityId], references: [id])
  locationId     String
  location       Location        @relation(fields: [locationId], references: [id])
  quantity       Decimal         @db.Decimal(20, 6)
  unit           String
  valuationPrice Decimal         @db.Decimal(20, 6)
  totalValue     Decimal         @db.Decimal(20, 4)
  qualityGrade   String?
  warehouseRef   String?
  arrivalDate    DateTime?
  expiryDate     DateTime?
  status         InventoryStatus
  reservedQty    Decimal         @default(0) @db.Decimal(20, 6)
  inTransitQty   Decimal         @default(0) @db.Decimal(20, 6)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String
  createdBy      User            @relation("InventoryCreatedBy", fields: [createdById], references: [id])

  movements InventoryMovement[]
  shipments Shipment[]

  @@index([commodityId, locationId])
}

model InventoryMovement {
  id           String       @id @default(cuid())
  inventoryId  String
  inventory    Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  movementType MovementType
  quantity     Decimal      @db.Decimal(20, 6)
  movementDate DateTime
  reference    String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String
  createdBy    User         @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([inventoryId, movementDate])
}

model Shipment {
  id          String     @id @default(cuid())
  tradeId     String?
  trade       Trade?     @relation(fields: [tradeId], references: [id])
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id])
  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  quantity    Decimal    @db.Decimal(20, 6)
  shippedAt   DateTime
  reference   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String
  createdBy   User       @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
}

// ─── Execution runtime ───────────────────────────────────────────────────────

enum ContractStatus {
  Open
  Close
}

/// Locked-contract snapshot + live fulfillment state. Created at lock from
/// the Trade; commodity / counterparty fields are intentional denormalized
/// snapshots of terms at lock time.
model ExecutionContract {
  id       String @id @default(cuid())
  tradeRef String @unique
  tradeId  String @unique
  trade    Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  contractDate     DateTime
  direction        TradeDirection
  executionProfile ExecutionProfile
  tradeScope       TradeScope
  incoterms        String
  buyingCategory   BuyingCategory?

  commodityCode    String
  commodityName    String
  counterpartyName String
  counterpartyCode String
  counterpartyNtn  String?

  quantityUnit      String
  contractualQtyMt  Decimal @db.Decimal(20, 6)
  receivedQtyMt     Decimal @default(0) @db.Decimal(20, 6)
  openQtyMt         Decimal @default(0) @db.Decimal(20, 6)
  contractStatus    ContractStatus @default(Open)
  quantityToleranceMt Decimal @default(0) @db.Decimal(20, 6)
  /// { damagePct, brokenPct, fungusPct, foreignMatterPct, moisturePct }
  qualityTolerances Json

  ratePerMaund       Decimal? @db.Decimal(20, 6)
  ratePerKg          Decimal? @db.Decimal(20, 6)
  unitPrice          Decimal? @db.Decimal(20, 6)
  priceCurrency      String?
  priceWeightUnit    String?
  commissionPerMaund Decimal? @db.Decimal(20, 6)
  currency           String

  warehouseDefault          String?
  traderWarehouseHint       String?
  traderWarehouseSelections String[] @default([])
  /// @deprecated single-warehouse display value; use allocations.
  allocatedWarehouse        String?

  traderName String
  lockedAt   DateTime
  lockedBy   String
  deliveryStart DateTime?
  deliveryEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouseAllocations ContractWarehouseAllocation[]

  @@index([contractStatus, executionProfile])
  @@index([commodityCode])
}

/// Split warehouse allocation lines — sum(qtyMt) equals contractualQtyMt.
model ContractWarehouseAllocation {
  id         String            @id @default(cuid())
  contractId String
  contract   ExecutionContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Warehouse display name (business key used across execution flows).
  warehouseName String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  qtyMt          Decimal @db.Decimal(20, 6)
  fulfilledQtyMt Decimal @default(0) @db.Decimal(20, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, warehouseName])
  @@index([warehouseName])
}

enum TruckMovementType {
  INBOUND
  OUTBOUND
}

enum PendingTruckStatus {
  PENDING
  ASSIGNED
  PARTIAL
}

/// Workflow status of a gate invoice (auto-generated or manually entered).
enum GateInvoiceStage {
  PENDING_TRADE_APPROVAL
  HOLD_OLD_DUES
  WRONG_INVOICING
  /// Trader released part of the invoice and is holding the remainder — the
  /// truck stays in their queue until the rest is released.
  PARTIAL_PAYMENT
  PAYMENT_APPROVED
}

/// Outbound (sale) truck payment workflow. Set at trade assignment and
/// advanced by ledger balance + trader / finance / CEO approvals.
enum SaleTruckStage {
  /// Receivable computed but the buyer's ledger credit does not cover it yet.
  AWAITING_BALANCE
  /// Sent to the trade's trader for sell-invoice approval.
  PENDING_TRADER
  /// Trader approved — awaiting finance approval.
  PENDING_FINANCE
  /// Trader + finance approved — payment received, truck may gate out.
  PAYMENT_RECEIVED
  /// Clear-without-payment path: awaiting the trade's trader.
  CLEAR_PENDING_TRADER
  /// Clear-without-payment path: trader agreed — awaiting CEO.
  CLEAR_PENDING_CEO
  /// CEO cleared the truck without full payment.
  CLEARED_UNPAID
  /// A released-on-credit truck later settled against ledger credit by finance.
  SETTLED
}

/// Gatepass entry logged at the warehouse gate (public REST form).
model PendingTruck {
  id         String   @id @default(cuid())
  gatepassNo String   @unique
  arrivalDate DateTime
  movementType TruckMovementType
  status       PendingTruckStatus @default(PENDING)

  warehouseName    String
  truckNo          String
  counterpartyName String
  commodityCode    String?
  commodityName    String?
  recordedByName   String?
  transporterName  String?
  transporterPhone String?
  builtyDetails    String?
  quantityAsPerBuilty String?
  weightAsPerBuiltyKg Decimal? @db.Decimal(20, 3)
  weighBridgeName  String?
  warehouseWeightKg Decimal? @db.Decimal(20, 3)
  qualitySpecs     Json?
  quantityBagsBales Int?
  totalDeductionsKg Decimal? @db.Decimal(20, 3)
  weightKg   Decimal @default(0) @db.Decimal(20, 3)
  remarks    String?

  assignedTradeRef String?
  assignedTrade    Trade?   @relation("TruckAssignedTrade", fields: [assignedTradeRef], references: [tradeRef], onDelete: SetNull)
  assignedAt       DateTime?
  remainingKg      Decimal  @default(0) @db.Decimal(20, 3)

  // Gate-in invoice (inbound) — entered manually and validated against the
  // expected amount computed at trade assignment.
  gateInvoiceNo        String?
  gateInvoiceWeightKg  Decimal? @db.Decimal(20, 3)
  gateInvoiceQtyMt     Decimal? @db.Decimal(20, 6)
  gateInvoiceAmount    Decimal? @db.Decimal(20, 4)
  gateInvoiceCurrency  String?
  gateInvoiceRatePerKg Decimal? @db.Decimal(20, 6)
  gateInvoiceTradeRef  String?
  gateInvoiceTrade     Trade?   @relation("TruckGateInvoiceTrade", fields: [gateInvoiceTradeRef], references: [tradeRef], onDelete: SetNull)
  /// Workflow stage of the gate invoice (default PENDING_TRADE_APPROVAL when an invoice exists).
  gateInvoiceStage     GateInvoiceStage?
  /// Expected invoice amount (PKR) computed at trade assignment — net warehouse weight × contract rate.
  gateInvoiceExpectedPkr Decimal? @db.Decimal(20, 4)
  /// Why the trader is holding back part (or all) of this invoice.
  gateInvoiceHoldNote    String?

  // ── Outbound sale payment workflow (movementType = OUTBOUND) ──
  /// Sale value before tax: dispatched weight × contract rate (PKR).
  saleBasePkr     Decimal? @db.Decimal(20, 2)
  /// 236G advance income tax on the base amount (PKR), at the policy rate.
  saleTaxPkr      Decimal? @db.Decimal(20, 2)
  /// Expected receivable incl. 236G — the ledger debit for this truck (PKR).
  saleExpectedPkr Decimal? @db.Decimal(20, 2)
  saleStage       SaleTruckStage?
  saleTraderApprovedBy  String?
  saleTraderApprovedAt  DateTime?
  saleFinanceApprovedBy String?
  saleFinanceApprovedAt DateTime?
  saleCeoApprovedBy     String?
  saleCeoApprovedAt     DateTime?
  /// Printable release documents, numbered on payment approval / CEO clearance.
  gateOutSlipNo   String? @unique
  deliveryOrderNo String? @unique
  /// Manual release toggle — printed slips handed to the warehouse manager.
  saleReleasedAt  DateTime?
  saleReleasedBy  String?
  /// Settle-against-old-dues (finance) for released-unpaid trucks.
  saleSettledAt   DateTime?
  saleSettledBy   String?

  // ── Inbound over-delivery approval (movementType = INBOUND) ──
  /// Set when a truck delivers more than the target trade's open qty + tolerance.
  overDeliveryStage    InboundOverStage?
  overDeliveryTradeRef String?
  overDeliveryQtyKg    Decimal? @db.Decimal(20, 3)
  overDeliveryTraderBy String?
  overDeliveryTraderAt DateTime?
  overDeliveryCeoBy    String?
  overDeliveryCeoAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents GatepassDocument[]
  inboundReceipts  InboundReceipt[]
  outboundDispatches OutboundDispatch[]

  @@index([status, movementType])
  @@index([warehouseName])
}

/// Uploaded gatepass files (builty, weigh slips, photos) — binary lives in
/// Supabase Storage; this row is the metadata + storage key.
model GatepassDocument {
  id         String       @id @default(cuid())
  gatepassNo String
  truck      PendingTruck @relation(fields: [gatepassNo], references: [gatepassNo], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  uploadedAt  DateTime @default(now())

  @@index([gatepassNo])
}

enum InboundReceiptStatus {
  DRAFT
  ALLOCATED
  FINANCE_PENDING
  /// Part of the amount due has been paid; the trader is holding the rest.
  PARTIALLY_PAID
  PAID
}

/// Warehouse receiving record for PURCHASE_DELIVERED fulfillment.
model InboundReceipt {
  id    String @id @default(cuid())
  kcsNo String @unique
  gatepassNo String?
  gatepassTruck PendingTruck? @relation(fields: [gatepassNo], references: [gatepassNo], onDelete: SetNull)
  tradeRef String
  trade    Trade  @relation(fields: [tradeRef], references: [tradeRef], onDelete: Cascade)

  receiveDate DateTime
  truckNo     String
  driverName  String?
  driverCnic  String?
  driverPhone String?
  biltyNo     String
  trnNo       String
  warehouseName String
  sellerName    String
  billNo String?
  bags   Int?

  weightSpotKg      Decimal @db.Decimal(20, 3)
  weightWarehouseKg Decimal @db.Decimal(20, 3)
  weightDiffKg      Decimal @db.Decimal(20, 3)

  // Quality readings at receiving.
  damagePct        Decimal @default(0) @db.Decimal(6, 3)
  brokenPct        Decimal @default(0) @db.Decimal(6, 3)
  fungusPct        Decimal @default(0) @db.Decimal(6, 3)
  foreignMatterPct Decimal @default(0) @db.Decimal(6, 3)
  moisturePct      Decimal @default(0) @db.Decimal(6, 3)
  deductionPct     Decimal @default(0) @db.Decimal(6, 3)

  allocatedQtyMt     Decimal @db.Decimal(20, 6)
  fifoOverrideReason String?
  amountDue          Decimal @default(0) @db.Decimal(20, 4)
  /// Running total actually paid to the seller — equals amountDue once fully
  /// paid, less while the trader is holding part of it back.
  paidAmountPkr      Decimal @default(0) @db.Decimal(20, 4)
  status             InboundReceiptStatus @default(DRAFT)
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  documentRefs String[] @default([])
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeRef, status])
  @@index([warehouseName])
}

enum OutboundDispatchStatus {
  AT_GATE
  WEIGHED
  FINANCE_PENDING
  RELEASED
}

/// Warehouse dispatch record for SALE_EX_WAREHOUSE fulfillment.
model OutboundDispatch {
  id String @id @default(cuid())
  gatepassNo String?
  gatepassTruck PendingTruck? @relation(fields: [gatepassNo], references: [gatepassNo], onDelete: SetNull)
  tradeRef String
  trade    Trade  @relation(fields: [tradeRef], references: [tradeRef], onDelete: Cascade)

  dispatchDate DateTime
  liftedBy     String
  buyerName    String
  warehouseName String
  truckNo      String
  driverName   String?
  driverCnic   String?
  driverPhone  String?

  dispatchWeightKg Decimal @db.Decimal(20, 3)
  invoiceWeightKg  Decimal @db.Decimal(20, 3)
  fungusPct        Decimal @default(0) @db.Decimal(6, 3)
  doRef            String?
  fifoOverrideReason String?
  allocatedQtyMt   Decimal @db.Decimal(20, 6)
  amountDue        Decimal @default(0) @db.Decimal(20, 4)
  status           OutboundDispatchStatus @default(AT_GATE)
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  documentRefs String[] @default([])
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeRef, status])
  @@index([warehouseName])
}

enum SpotPurchaseState {
  CONTRACT
  SELECTED
  LOADED
  DC_ISSUED
  INVOICED
  FINANCE_PENDING
  PAID
  ON_THE_WAY
  RECEIVED
}

/// PURCHASE_SPOT pipeline state (one live event per spot trade).
model SpotPurchaseEvent {
  id       String @id @default(cuid())
  tradeRef String @unique
  trade    Trade  @relation(fields: [tradeRef], references: [tradeRef], onDelete: Cascade)
  state    SpotPurchaseState @default(CONTRACT)
  selectorNotes   String?
  brokerName      String?
  dcNo            String?
  truckNo         String?
  spotWeightKg    Decimal? @db.Decimal(20, 3)
  brokerInvoiceRef String?
  invoiceAmount   Decimal? @db.Decimal(20, 4)
  warehouseReceiveWeightKg Decimal? @db.Decimal(20, 3)
  weightVarianceKg Decimal? @db.Decimal(20, 3)
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentSourceType {
  INBOUND
  OUTBOUND
  SPOT
}

/// Finance approval queue entry raised from inbound / outbound / spot flows.
model PaymentRequest {
  id         String @id @default(cuid())
  requestRef String @unique
  sourceType PaymentSourceType
  /// Id of the source InboundReceipt / OutboundDispatch / SpotPurchaseEvent.
  sourceId   String
  tradeRef   String
  trade      Trade  @relation(fields: [tradeRef], references: [tradeRef], onDelete: Cascade)
  counterpartyName String
  amount   Decimal @db.Decimal(20, 4)
  currency String
  status   PaymentRequestStatus @default(PENDING)
  financeComment String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inboundReceipts    InboundReceipt[]
  outboundDispatches OutboundDispatch[]
  spotEvents         SpotPurchaseEvent[]

  @@index([status, sourceType])
  @@index([tradeRef])
}

// ─── Approvals workflow ──────────────────────────────────────────────────────

enum Department {
  EXECUTION
  FINANCE
  TRADING
}

enum ChangeRequestAction {
  CREATE
  EDIT
  DELETE
  CLOSE
}

enum ChangeRequestStatus {
  PENDING
  PENDING_CEO
  APPROVED
  REJECTED
}

/// Department / CEO approval requests. entityRef is a polymorphic business
/// reference (trade ref, gatepass no, payment ref, warehouse name, …) —
/// resolved by entityType in server/change-request-apply.ts.
model ChangeRequest {
  id         String @id
  department Department
  entityType String
  entityRef  String
  entityLabel String
  action     ChangeRequestAction
  comment    String
  requestedById String
  requestedBy   User   @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  requestedByName String
  requestedAt     DateTime @default(now())
  status ChangeRequestStatus @default(PENDING)
  resolvedByName String?
  resolvedAt     DateTime?
  resolutionNote String?
  applied Boolean @default(false)
  payload Json?
  departmentApprovedByName String?
  departmentApprovedAt     DateTime?
  departmentApprovalNote   String?

  tradeActivities TradeActivity[]

  @@index([status, department])
  @@index([requestedById])
  @@index([entityType, entityRef])
}

// ─── Finance (analytics) ─────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum InvoiceType {
  PURCHASE
  SALES
  PROVISIONAL
  FINAL
  /// Raised against a directly settled trade — no delivery, no gatepass, no
  /// inventory. Carries the receivable that vouchers are collected against.
  SETTLEMENT
}

model Invoice {
  id             String       @id @default(cuid())
  invoiceRef     String       @unique
  tradeId        String
  trade          Trade        @relation(fields: [tradeId], references: [id])
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  invoiceDate    DateTime
  dueDate        DateTime
  amount         Decimal      @db.Decimal(20, 4)
  quantity       Decimal?     @db.Decimal(20, 6)
  currency       String
  status         InvoiceStatus
  invoiceType    InvoiceType
  /// What this invoice covers — shown on the settlement page and the ledger.
  note           String?
  /// Settlement invoices only: raised in error and reversed off the ledger.
  voidedAt       DateTime?
  voidedBy       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String
  createdBy      User         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  payments    Payment[]
  ledgerEntry CounterpartyLedgerEntry?

  @@index([tradeId, invoiceType])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  paymentDate DateTime
  amount      Decimal  @db.Decimal(20, 4)
  currency    String
  method      String
  reference   String?
  bankRef     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
}

enum CashFlowType {
  TRADE_RECEIPT
  TRADE_PAYMENT
  FINANCING
  FX
  OVERHEAD
  OTHER
}

model CashFlowEntry {
  id          String       @id @default(cuid())
  entryDate   DateTime
  valueDate   DateTime
  entryType   CashFlowType
  amount      Decimal      @db.Decimal(20, 4)
  currency    String
  description String
  tradeRef    String?
  invoiceRef  String?
  isProjected Boolean      @default(false)
  isPaid      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation("CashFlowEntryCreatedBy", fields: [createdById], references: [id])

  @@index([valueDate])
}

enum ReconType {
  TRADE_VS_INVOICE
  INVOICE_VS_PAYMENT
  POSITION_VS_INVENTORY
  PAYMENT_VS_BANK
}

enum ReconStatus {
  MATCHED
  BREAK
  PENDING_REVIEW
  RESOLVED
}

model Reconciliation {
  id             String      @id @default(cuid())
  reconDate      DateTime
  reconType      ReconType
  referenceA     String
  referenceB     String
  expectedAmount Decimal     @db.Decimal(20, 4)
  actualAmount   Decimal     @db.Decimal(20, 4)
  difference     Decimal     @db.Decimal(20, 4)
  status         ReconStatus
  notes          String?
  resolvedAt     DateTime?
  assignedTo     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String
  createdBy      User        @relation("ReconciliationCreatedBy", fields: [createdById], references: [id])

  @@index([status, reconDate])
}

model BankTransaction {
  id          String   @id @default(cuid())
  valueDate   DateTime
  amount      Decimal  @db.Decimal(20, 4)
  currency    String
  description String
  bankRef     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("BankTransactionCreatedBy", fields: [createdById], references: [id])

  @@index([valueDate])
}

// ─── Traceability ────────────────────────────────────────────────────────────

enum TraceEventType {
  HARVEST
  PROCESSING
  STORAGE
  TRANSPORT
  SALE
}

model TraceabilityRecord {
  id             String    @id @default(cuid())
  batchRef       String    @unique
  commodityId    String
  commodity      Commodity @relation(fields: [commodityId], references: [id])
  originFarm     String
  farmerName     String?
  farmLocation   String
  harvestDate    DateTime
  quantity       Decimal   @db.Decimal(20, 6)
  certifications String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String
  createdBy      User      @relation("TraceabilityRecordCreatedBy", fields: [createdById], references: [id])

  chainOfCustody TraceChainEntry[]
  tradeLinks     TradeTraceabilityLink[]
}

model TraceChainEntry {
  id          String             @id @default(cuid())
  batchId     String
  batch       TraceabilityRecord @relation(fields: [batchId], references: [id], onDelete: Cascade)
  eventType   TraceEventType
  eventDate   DateTime
  location    String
  actor       String
  notes       String?
  documents   String[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String
  createdBy   User               @relation("TraceChainEntryCreatedBy", fields: [createdById], references: [id])

  @@index([batchId, eventDate])
}

model TradeTraceabilityLink {
  id          String             @id @default(cuid())
  tradeId     String
  trade       Trade              @relation(fields: [tradeId], references: [id])
  batchId     String
  batch       TraceabilityRecord @relation(fields: [batchId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String
  createdBy   User               @relation("TradeTraceLinkCreatedBy", fields: [createdById], references: [id])

  @@unique([tradeId, batchId])
}

// ─── Finance policies, counterparty ledgers & vouchers ──────────────────────

/// Company-wide finance policy knobs — single row, edited on the Finance →
/// Policies page and read everywhere else in the app.
model FinancePolicy {
  id String @id @default("main")
  /// Yearly inflow cap per buyer (PKR received, fiscal year 1 Jul – 30 Jun).
  yearlyInflowLimitPkr Decimal @default(200000000) @db.Decimal(20, 2)
  /// 236G advance income tax — ATL filer rate (percent of price × quantity).
  advanceTaxRatePct Decimal @default(0.1) @db.Decimal(8, 4)
  /// 236G advance income tax — non-filer rate.
  advanceTaxRatePctNonFiler Decimal @default(2.0) @db.Decimal(8, 4)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  GATEPASS
  VOUCHER
  PAYMENT
  ADJUSTMENT
  /// Settlement-invoice receivable on a trade closed with no delivery — the
  /// debit source that replaces the outbound truck for settled trades.
  INVOICE
}

/// Running credit/debit ledger for SELL-side counterparties. DEBIT rows are
/// posted when an outbound gatepass truck is assigned to a sale trade
/// (receivable incl. 236G); CREDIT rows are posted when finance approves a
/// payment voucher.
model CounterpartyLedgerEntry {
  id             String       @id @default(cuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  /// BUY ledger (payables to them) vs SELL ledger (receivables from them) —
  /// two separate accounts per counterparty that never mix.
  side           CounterpartySide @default(SELL)
  entryDate      DateTime     @default(now())
  entryType      LedgerEntryType
  amountPkr      Decimal      @db.Decimal(20, 2)
  sourceType     LedgerSourceType
  /// Business ref backing this entry (gatepass no / voucher no).
  sourceRef      String?
  tradeRef       String?
  /// Debit entries: the outbound PendingTruck that raised the receivable.
  truckId        String?      @unique
  /// Debit entries on settled trades: the settlement invoice that raised the
  /// receivable (there is no truck on a settled trade).
  invoiceId      String?      @unique
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Credit entries: the finance-approved voucher.
  voucherId      String?      @unique
  voucher        Voucher?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  /// Aging anchor for debits on N-day credit terms (arrival + credit days).
  dueDate        DateTime?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([counterpartyId, entryDate])
  @@index([counterpartyId, side, entryDate])
  @@index([entryType])
}

/// Rejected requests (sell-truck clearances, vouchers, payments) — every
/// rejection carries a required reason and shows on each portal's
/// Rejections page.
model RejectionRecord {
  id        String   @id @default(cuid())
  /// SELL_RELEASE_TRADER | SELL_RELEASE_CEO | VOUCHER | PAYMENT
  kind      String
  /// Human ref shown in lists (gatepass no, voucher no, payment ref).
  refLabel  String
  gatepassNo String?
  voucherNo  String?
  tradeRef   String?
  counterpartyName String?
  amountPkr  Decimal? @db.Decimal(20, 2)
  /// Owning trader (for trader-portal filtering), when applicable.
  traderName String?
  rejectedBy   String
  rejectedRole String
  reason       String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([traderName])
}

enum VoucherStatus {
  PENDING_FINANCE
  APPROVED
  REJECTED
}

/// Money-ingestion voucher entered by execution against a SELL-side
/// counterparty. Credits the ledger only once finance approves it.
model Voucher {
  id             String        @id @default(cuid())
  voucherNo      String        @unique
  counterpartyId String
  counterparty   Counterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  /// Which ledger account this voucher credits — SELL for money received on a
  /// sale, BUY for money on a purchase (a settled purchase collects here, so
  /// the two sides never mix).
  side           CounterpartySide @default(SELL)
  /// Trade this payment is against; null = direct advance (usable for any of
  /// the counterparty's trades). Shown on every ledger entry.
  tradeRef       String?
  amountPkr      Decimal       @db.Decimal(20, 2)
  /// Payment method (bank transfer, cheque, cash, …).
  method         String?
  /// Bank / cheque / deposit reference.
  reference      String?
  note           String?
  status         VoucherStatus @default(PENDING_FINANCE)
  enteredByName  String
  resolvedByName String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  ledgerEntry CounterpartyLedgerEntry?

  @@index([status])
  @@index([counterpartyId])
  @@index([tradeRef])
}

/// Unfinished trade-booking form state, autosaved from the booking page so a
/// closed tab or dropped connection never loses the trader's work.
model TradeDraft {
  id         String   @id @default(cuid())
  traderName String
  /// Full serialized booking-form state (form values + aux selections).
  payload    Json
  /// Light display summary for the My Trades list (labels only).
  summary    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([traderName, updatedAt])
}

// ─── Infrastructure ──────────────────────────────────────────────────────────

/// Named business-reference counters (trade refs, KCS numbers, gatepass
/// numbers, change-request ids, …). Incremented inside a transaction with
/// SELECT … FOR UPDATE so concurrent users can never receive the same ref.
model RefCounter {
  name  String @id
  value BigInt @default(0)
}
